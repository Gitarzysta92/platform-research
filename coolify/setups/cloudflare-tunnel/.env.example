# Copy to .env and fill in locally. Never put real tokens in this example.
# Loaded explicitly by the shell; Terraform does not load .env files itself.
COOLIFY_TOKEN=''
CLOUDFLARE_API_TOKEN=''

# Optional local reference: the existing tunnel connector token.
# Terraform retrieves the connector token through the Cloudflare API;
# this value is NOT a replacement for CLOUDFLARE_API_TOKEN and is not read by Terraform.
TUNNEL_TOKEN=''
